# Copy to .env. Every value below has a working local-development default in docker-compose.yml.

# Sentinel
JWT_SECRET=replace-with-a-long-random-secret
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# Tilda Goods e-commerce
TILDA_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@tilda.local
ADMIN_NAME=Store Admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Recovery Controller <-> Sentinel shared secret (16+ chars). The controller refuses to start without it.
RECOVERY_TOKEN=replace-with-a-long-random-token

# Optional monitoring tuning (defaults shown)
# SERVICE_CHECK_INTERVAL_MS=5000
# SERVICE_FAILURE_THRESHOLD=2
# SERVICE_RECOVERY_THRESHOLD=2
